rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }

    match /product_images/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && (
          (request.resource.contentType.matches('image/.*')
            && request.resource.size < 10 * 1024 * 1024) ||
          (request.resource.contentType.matches('video/.*')
            && request.resource.size < 100 * 1024 * 1024)
        );
    }

    match /avatars/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /storefront_assets/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /review_photos/{reviewId}/{uid}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function attachmentTypeAllowed() {
      return request.resource.contentType in [
        'image/jpeg', 'image/png', 'image/webp', 'image/heic', 'image/heif',
        'application/pdf',
        'application/msword',
        'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
        'application/vnd.ms-excel',
        'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
        'text/plain', 'text/csv'
      ];
    }

    function attachmentSizeAllowed() {
      return request.resource.contentType in [
          'image/jpeg', 'image/png', 'image/webp', 'image/heic', 'image/heif'
        ]
        ? request.resource.size <= 10 * 1024 * 1024
        : request.resource.size <= 20 * 1024 * 1024;
    }

    function isAttachmentUploader() {
      return request.auth != null
        && request.resource.metadata.uploaderUid == request.auth.uid;
    }

    function ownsExistingAttachment() {
      return request.auth != null
        && resource.metadata.uploaderUid == request.auth.uid;
    }

    match /chat_attachments/{chatId}/{messageId}/{fileName} {
      allow read: if ownsExistingAttachment();
      allow create: if isAttachmentUploader()
        && attachmentTypeAllowed()
        && attachmentSizeAllowed();
      allow update: if ownsExistingAttachment()
        && isAttachmentUploader()
        && attachmentTypeAllowed()
        && attachmentSizeAllowed();
      allow delete: if ownsExistingAttachment();
    }

    match /ticket_attachments/{ticketId}/{messageId}/{fileName} {
      allow read: if ownsExistingAttachment();
      allow create: if isAttachmentUploader()
        && attachmentTypeAllowed()
        && attachmentSizeAllowed();
      allow update: if ownsExistingAttachment()
        && isAttachmentUploader()
        && attachmentTypeAllowed()
        && attachmentSizeAllowed();
      allow delete: if ownsExistingAttachment();
    }

    match /stories/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /temp_analysis/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /temp_visual_search/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
